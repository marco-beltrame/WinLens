<Project Sdk="Microsoft.NET.Sdk">

  <!-- Platform-neutral logic (no WPF, no WinRT) so it can be unit-tested on any OS. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>WinLens</RootNamespace>
    <AssemblyName>WinLens.Core</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Managed bindings only: the native runtime (17 MB) is downloaded with the first
         offline language, so it adds nothing to the default download. The offline models
         workflow fetches the native DLL of this same version. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.31.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WinLens.Core.Tests" />
  </ItemGroup>

</Project>
