<Project Sdk="Microsoft.NET.Sdk">

  <!-- Platform-neutral logic (no WPF, no WinRT) so it can be unit-tested on any OS. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>WinLens</RootNamespace>
    <AssemblyName>WinLens.Core</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WinLens.Core.Tests" />
  </ItemGroup>

</Project>
