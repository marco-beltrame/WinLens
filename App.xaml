<Application x:Class="WinLens.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The palette stays first: ThemeManager replaces it with the light one
                     when Windows is in light mode. -->
                <ResourceDictionary Source="/src/Theme/Palette.Dark.xaml"/>
                <ResourceDictionary Source="/src/Theme/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
