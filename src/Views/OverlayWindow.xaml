<Window x:Class="WinLens.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinLens Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Opacity="0">
    <Grid>
        <!-- Backdrop, visible only where the capture does not reach (region capture:
             the rest of that monitor). Dimming it shows what was translated. The alpha
             also has to be non-zero: fully transparent areas of an AllowsTransparency
             window are click-through, and this area must still swallow clicks. -->
        <Canvas x:Name="BackdropCanvas" Background="#66000000">
            <Image x:Name="BackgroundImage"/>
        </Canvas>

        <!-- Translation boxes. Separate canvas so rebuilding the boxes on a language
             change cannot clear the screenshot underneath. -->
        <Canvas x:Name="OverlayCanvas" Background="#01000000"/>

        <!-- Floating control bar. The backing shape casts the shadow, so the controls
             above it are drawn directly instead of through the blur effect. -->
        <Grid x:Name="TopBar" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0">
            <Border CornerRadius="12" Background="{DynamicResource PopupBrush}">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="5" Direction="270"
                                      Opacity="0.4"/>
                </Border.Effect>
            </Border>
            <Border CornerRadius="12" Padding="7"
                    Background="{DynamicResource PopupBrush}"
                    BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="22" Height="22" Source="{StaticResource LogoImage}" Margin="5,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <ComboBox x:Name="LanguageBox" Width="172"
                              Style="{StaticResource ModernComboBox}"
                              VerticalAlignment="Center"
                              SelectionChanged="OnLanguageChanged"
                              AutomationProperties.Name="Translate to"/>
                    <Border Width="1" Height="18" Margin="8,0,6,0"
                            Background="{DynamicResource BorderStrongBrush}"/>
                    <Button x:Name="CloseBtn" Style="{StaticResource IconButton}"
                            Click="OnCloseClick" ToolTip="Close (Esc)"
                            AutomationProperties.Name="Close">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconClose}"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
