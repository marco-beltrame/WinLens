<Window x:Class="WinLens.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="WinLens"
        Width="1" Height="1"
        WindowStyle="None"
        ShowInTaskbar="False"
        Visibility="Hidden"
        AllowsTransparency="True"
        Background="Transparent">
    <Grid>
        <tb:TaskbarIcon x:Name="Tray"
                        ToolTipText="WinLens — screen translator"
                        Visibility="Visible"
                        TrayMouseDoubleClick="OnTrayDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <!-- The shortcut hints are filled in when the menu opens (OnTrayMenuOpened). -->
                <ContextMenu Style="{StaticResource ModernContextMenu}" MinWidth="270"
                             Opened="OnTrayMenuOpened">
                    <MenuItem x:Name="TranslateScreenItem" Header="Translate screen" Click="OnTranslateNow">
                        <MenuItem.Icon>
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconScreen}"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="TranslateRegionItem" Header="Translate region" Click="OnTranslateRegion">
                        <MenuItem.Icon>
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconRegion}"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Settings" Click="OnOpenSettings">
                        <MenuItem.Icon>
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconSettings}"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Exit" Click="OnExit">
                        <MenuItem.Icon>
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconExit}"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</Window>
