<Window x:Class="WinLens.Views.LoadingOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        IsHitTestVisible="False"
        Focusable="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        Foreground="{DynamicResource TextBrush}">

    <!-- The margin is room for the shadow, cast by the plain backing shape. -->
    <Grid Margin="24">
        <Border CornerRadius="12" Background="{DynamicResource PopupBrush}">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="5" Direction="270"
                                  Opacity="0.4"/>
            </Border.Effect>
        </Border>
        <Border Padding="14,12,18,12" CornerRadius="12"
                Background="{DynamicResource PopupBrush}"
                BorderBrush="{DynamicResource BorderStrongBrush}"
                BorderThickness="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="18" Height="18">
                    <Ellipse StrokeThickness="2.5" Stroke="{DynamicResource BorderStrongBrush}"/>
                    <Ellipse StrokeThickness="2.5" Stroke="{DynamicResource AccentBrush}"
                             StrokeDashArray="6 100" StrokeDashCap="Round"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="Rot"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>
                <TextBlock Text="Translating…" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="11,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Rot"
                                     Storyboard.TargetProperty="Angle"
                                     From="0" To="360" Duration="0:0:0.85"
                                     RepeatBehavior="Forever"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
