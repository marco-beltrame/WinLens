<Window x:Class="WinLens.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinLens"
        Icon="/assets/winlens.ico"
        Width="440" Height="756"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI">

    <Border Margin="16" CornerRadius="16"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource BorderStrongBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="6" Opacity="0.55"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ============== Title bar ============== -->
            <Grid x:Name="TitleBar" Grid.Row="0" Height="48" Background="Transparent"
                  MouseLeftButtonDown="OnTitleBarDrag">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Image Width="28" Height="28" Source="/assets/logo.png"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="WinLens" Foreground="{StaticResource TextBrush}"
                               FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,10,0">
                    <Button Style="{StaticResource TitleBarButton}" Click="OnMinimize" Content="&#xE921;"
                            FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    <Button Style="{StaticResource CloseButton}" Click="OnClose" Content="&#xE8BB;"
                            FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </StackPanel>
            </Grid>

            <!-- ============== Content ============== -->
            <!-- Scrolls so the window still works on a short display (the settings list
                 grew past what fits on a 768 px laptop screen). -->
            <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="22,6,22,20">

                <TextBlock Text="Translate your screen" Style="{StaticResource H1Text}"/>

                <Button x:Name="TranslateButton" Style="{StaticResource PrimaryButton}"
                        Margin="0,18,0,0" Click="OnTranslateNow">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Ellipse Canvas.Left="3" Canvas.Top="3" Width="13" Height="13"
                                         Stroke="White" StrokeThickness="2.2"/>
                                <Line X1="14" Y1="14" X2="21" Y2="21" Stroke="White" StrokeThickness="2.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Translate now" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Target language -->
                <TextBlock Text="TARGET LANGUAGE" Style="{StaticResource LabelText}" Margin="2,22,0,8"/>
                <ComboBox x:Name="LanguageCombo" Style="{StaticResource ModernComboBox}"
                          SelectionChanged="OnLanguageChanged"/>

                <TextBlock Text="DETECT TEXT IN (OCR)" Style="{StaticResource LabelText}" Margin="2,16,0,8"/>
                <ComboBox x:Name="SourceCombo" Style="{StaticResource ModernComboBox}"
                          DisplayMemberPath="Label" SelectionChanged="OnSourceChanged"/>
                <TextBlock x:Name="AddLangLink" Margin="2,8,0,0" Cursor="Hand"
                           Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="SemiBold"
                           Text="+ Add OCR languages in Windows…"
                           MouseLeftButtonUp="OnAddLanguages"/>

                <!-- Translation engine -->
                <TextBlock Text="TRANSLATION ENGINE" Style="{StaticResource LabelText}" Margin="2,20,0,8"/>
                <ComboBox x:Name="EngineCombo" Style="{StaticResource ModernComboBox}"
                          SelectionChanged="OnEngineChanged">
                    <ComboBoxItem Tag="google" Content="Google Translate"/>
                    <ComboBoxItem Tag="libretranslate" Content="LibreTranslate"/>
                    <ComboBoxItem Tag="local-llm" Content="Local AI model"/>
                </ComboBox>
                <TextBlock x:Name="EngineCaption" Style="{StaticResource CaptionText}" Margin="2,8,0,0"
                           TextWrapping="Wrap"/>

                <StackPanel x:Name="EnginePanel" Visibility="Collapsed">
                    <TextBlock Text="SERVER ADDRESS" Style="{StaticResource LabelText}" Margin="2,14,0,8"/>
                    <TextBox x:Name="EngineUrlBox" Style="{StaticResource ModernTextBox}"
                             LostKeyboardFocus="OnEngineFieldCommitted"/>

                    <StackPanel x:Name="ModelPanel">
                        <TextBlock Text="MODEL" Style="{StaticResource LabelText}" Margin="2,14,0,8"/>
                        <TextBox x:Name="EngineModelBox" Style="{StaticResource ModernTextBox}"
                                 Tag="First model on the server"
                                 LostKeyboardFocus="OnEngineFieldCommitted"/>
                    </StackPanel>

                    <TextBlock Text="API KEY (OPTIONAL)" Style="{StaticResource LabelText}" Margin="2,14,0,8"/>
                    <PasswordBox x:Name="EngineKeyBox" Style="{StaticResource ModernPasswordBox}"
                                 LostKeyboardFocus="OnEngineFieldCommitted"/>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Use Google as a backup" Foreground="{StaticResource TextBrush}"
                                       FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="For lines your server can't translate. Off keeps your text on your server."
                                       Style="{StaticResource CaptionText}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <CheckBox x:Name="FallbackToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center"
                                  Checked="OnFallbackToggled" Unchecked="OnFallbackToggled"/>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="TestEngineButton" Grid.Column="0" Style="{StaticResource SecondaryButton}"
                                Content="Test connection" Click="OnTestEngine"/>
                        <TextBlock x:Name="EngineStatus" Grid.Column="1" Margin="12,0,0,0"
                                   VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{StaticResource TextSubtleBrush}"/>
                    </Grid>
                </StackPanel>

                <!-- Shortcut: translates the monitor the cursor is on -->
                <TextBlock Text="TRANSLATE SHORTCUT" Style="{StaticResource LabelText}" Margin="2,20,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="HotkeyChip" Grid.Column="0" Height="42" CornerRadius="10"
                            Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <TextBlock x:Name="HotkeyText" VerticalAlignment="Center" Margin="14,0"
                                   Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold"/>
                    </Border>
                    <Button x:Name="ChangeHotkeyButton" Grid.Column="1" Style="{StaticResource SecondaryButton}"
                            Content="Change" Margin="10,0,0,0" Click="OnChangeHotkey"/>
                </Grid>

                <TextBlock x:Name="HotkeyMessage" Visibility="Collapsed" TextWrapping="Wrap"
                           Margin="2,8,0,0" FontSize="12" Foreground="{StaticResource DangerBrush}"/>

                <!-- Shortcut (drag-selected region) -->
                <TextBlock Text="REGION SHORTCUT" Style="{StaticResource LabelText}" Margin="2,16,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="RegionHotkeyChip" Grid.Column="0" Height="42" CornerRadius="10"
                            Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <TextBlock x:Name="RegionHotkeyText" VerticalAlignment="Center" Margin="14,0"
                                   Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold"/>
                    </Border>
                    <Button x:Name="ChangeRegionHotkeyButton" Grid.Column="1" Style="{StaticResource SecondaryButton}"
                            Content="Change" Margin="10,0,0,0" Click="OnChangeRegionHotkey"/>
                </Grid>

                <TextBlock x:Name="RegionHotkeyMessage" Visibility="Collapsed" TextWrapping="Wrap"
                           Margin="2,8,0,0" FontSize="12" Foreground="{StaticResource DangerBrush}"/>

                <!-- Launch at startup -->
                <Grid Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Launch at startup" Foreground="{StaticResource TextBrush}"
                                   FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Run WinLens automatically when you sign in."
                                   Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                        <TextBlock x:Name="StartupMessage" Visibility="Collapsed" TextWrapping="Wrap"
                                   Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource DangerBrush}"/>
                    </StackPanel>
                    <CheckBox x:Name="StartupToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                              VerticalAlignment="Center"
                              Checked="OnStartupToggled" Unchecked="OnStartupToggled"/>
                </Grid>

                <!-- Footer -->
                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,22,0,14"/>
                <TextBlock x:Name="FooterText" Style="{StaticResource CaptionText}"
                           HorizontalAlignment="Center"
                           Text="WinLens"/>
            </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
