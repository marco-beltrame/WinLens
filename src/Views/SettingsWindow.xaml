<Window x:Class="WinLens.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinLens"
        Icon="/assets/winlens.ico"
        Width="456"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        Foreground="{DynamicResource TextBrush}">

    <Window.Resources>
        <!-- A shortcut shown as keys; ItemsSource is the list of key names. -->
        <Style x:Key="Keycaps" TargetType="ItemsControl">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Border Style="{StaticResource Keycap}">
                            <TextBlock Text="{Binding}" FontSize="11.5" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The shortcut itself is the button that changes it. Tag="capturing" while the
             next key press is being recorded. -->
        <Style x:Key="ShortcutButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Padding="6,0,7,0"
                                Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ContentPresenter x:Name="Keys" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Prompt" Text="Press keys…" Visibility="Collapsed"
                                           Margin="4,0,6,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentTextBrush}"/>
                                <Path x:Name="Glyph" Style="{StaticResource Icon}" Data="{StaticResource IconEdit}"
                                      Margin="2,0,0,0" Stroke="{DynamicResource TextFaintBrush}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlBrush}"/>
                                <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource TextSubtleBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="capturing">
                                <Setter TargetName="Keys" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Prompt" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Glyph" Property="Data" Value="{StaticResource IconClose}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- The margin is room for the shadow. The shadow is cast by a plain backing shape so
         the content above it is drawn directly, not through the blur effect. -->
    <Grid x:Name="Chrome" Margin="24">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="ChromeShift"/>
        </Grid.RenderTransform>

        <Border CornerRadius="12" Background="{DynamicResource WindowBrush}">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="5" Direction="270"
                                  Opacity="{DynamicResource ShadowOpacity}"/>
            </Border.Effect>
        </Border>

        <Border CornerRadius="12"
                Background="{DynamicResource WindowBrush}"
                BorderBrush="{DynamicResource BorderStrongBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ============== Title bar ============== -->
                <Grid x:Name="TitleBar" Grid.Row="0" Height="44" Background="Transparent"
                      MouseLeftButtonDown="OnTitleBarDrag">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"
                                IsHitTestVisible="False">
                        <Image Width="20" Height="20" Source="{StaticResource LogoImage}"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="WinLens" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="9,0,0,0"/>
                        <TextBlock x:Name="VersionText" FontSize="11.5"
                                   Foreground="{DynamicResource TextFaintBrush}"
                                   VerticalAlignment="Center" Margin="7,1,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,8,0">
                        <Button Style="{StaticResource TitleBarButton}" Click="OnMinimize"
                                AutomationProperties.Name="Minimize">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconMinimize}"/>
                        </Button>
                        <Button Style="{StaticResource CloseButton}" Click="OnClose"
                                AutomationProperties.Name="Close">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconClose}"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ============== Content ============== -->
                <!-- Scrolls, so the window still works where the full list is taller than
                     the screen (a custom engine on a small laptop display). -->
                <ScrollViewer x:Name="ContentScroll" Grid.Row="1" Style="{StaticResource OverlayScrollViewer}">
                    <StackPanel Margin="16,4,16,16">

                        <!-- Actions -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="TranslateButton" Grid.Column="0" Style="{StaticResource PrimaryButton}"
                                    Click="OnTranslateNow">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconScreen}"/>
                                    <TextBlock Text="Translate screen" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="RegionButton" Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                    Height="40" Padding="16,0" Margin="8,0,0,0"
                                    Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource BorderStrongBrush}"
                                    Click="OnTranslateRegion">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconRegion}"/>
                                    <TextBlock Text="Region" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Languages -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Translate from" Style="{StaticResource RowLabel}"/>
                                    <!-- The languages Windows can read (OCR). The footer opens the
                                         Windows page where more can be installed. -->
                                    <ComboBox x:Name="SourceCombo" Grid.Column="1" Width="208"
                                              Style="{StaticResource ModernComboBox}"
                                              DisplayMemberPath="Label" SelectionChanged="OnSourceChanged"
                                              AutomationProperties.Name="Translate from">
                                        <ComboBox.Tag>
                                            <StackPanel>
                                                <Separator/>
                                                <Button Style="{StaticResource DropdownFooterButton}" Click="OnAddLanguages">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconAdd}"/>
                                                        <TextBlock Text="Add languages…" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </ComboBox.Tag>
                                    </ComboBox>
                                </Grid>
                                <Border Style="{StaticResource RowLine}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Translate to" Style="{StaticResource RowLabel}"/>
                                    <ComboBox x:Name="LanguageCombo" Grid.Column="1" Width="208"
                                              Style="{StaticResource ModernComboBox}"
                                              SelectionChanged="OnLanguageChanged"
                                              AutomationProperties.Name="Translate to"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Translation engine -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Translation engine" Style="{StaticResource RowLabel}"/>
                                    <ComboBox x:Name="EngineCombo" Grid.Column="1" Width="208"
                                              Style="{StaticResource ModernComboBox}"
                                              SelectionChanged="OnEngineChanged"
                                              AutomationProperties.Name="Translation engine">
                                        <ComboBoxItem Tag="google" Content="Google Translate"/>
                                        <ComboBoxItem Tag="libretranslate" Content="LibreTranslate"/>
                                        <ComboBoxItem Tag="local-llm" Content="Local AI model"/>
                                    </ComboBox>
                                </Grid>

                                <!-- Only for an engine the user runs or rents themselves. -->
                                <StackPanel x:Name="EnginePanel" Visibility="Collapsed">
                                    <Border Style="{StaticResource RowLine}"/>
                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Server address" Style="{StaticResource RowLabel}"/>
                                        <TextBox x:Name="EngineUrlBox" Grid.Column="1" Width="208"
                                                 Style="{StaticResource ModernTextBox}"
                                                 LostKeyboardFocus="OnEngineFieldCommitted"
                                                 AutomationProperties.Name="Server address"/>
                                    </Grid>

                                    <StackPanel x:Name="ModelPanel">
                                        <Border Style="{StaticResource RowLine}"/>
                                        <Grid Style="{StaticResource Row}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Model" Style="{StaticResource RowLabel}"/>
                                            <TextBox x:Name="EngineModelBox" Grid.Column="1" Width="208"
                                                     Style="{StaticResource ModernTextBox}"
                                                     Tag="First model on the server"
                                                     LostKeyboardFocus="OnEngineFieldCommitted"
                                                     AutomationProperties.Name="Model"/>
                                        </Grid>
                                    </StackPanel>

                                    <Border Style="{StaticResource RowLine}"/>
                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="API key" Style="{StaticResource RowLabel}"/>
                                        <Grid Grid.Column="1" Width="208">
                                            <PasswordBox x:Name="EngineKeyBox" Style="{StaticResource ModernPasswordBox}"
                                                         LostKeyboardFocus="OnEngineFieldCommitted"
                                                         PasswordChanged="OnEngineKeyChanged"
                                                         AutomationProperties.Name="API key"/>
                                            <!-- A password box has no placeholder of its own. -->
                                            <TextBlock x:Name="EngineKeyHint" Text="Optional" Margin="12,0,0,0"
                                                       Foreground="{DynamicResource TextFaintBrush}"
                                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                                        </Grid>
                                    </Grid>

                                    <Border Style="{StaticResource RowLine}"/>
                                    <Grid Style="{StaticResource Row}" Background="Transparent"
                                          ToolTip="For lines your server can't translate. Off keeps your text on your server.">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Use Google as a backup" Style="{StaticResource RowLabel}"/>
                                        <CheckBox x:Name="FallbackToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                                  VerticalAlignment="Center" Margin="0,0,6,0"
                                                  Checked="OnFallbackToggled" Unchecked="OnFallbackToggled"
                                                  AutomationProperties.Name="Use Google as a backup"/>
                                    </Grid>

                                    <Border Style="{StaticResource RowLine}"/>
                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="TestEngineButton" Grid.Column="0" Style="{StaticResource SecondaryButton}"
                                                VerticalAlignment="Center" Content="Test connection" Click="OnTestEngine"/>
                                        <TextBlock x:Name="EngineStatus" Grid.Column="1" Margin="12,8,6,8"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12"
                                                   Foreground="{DynamicResource TextSubtleBrush}"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Shortcuts: the whole monitor under the cursor, or a dragged region -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Screen shortcut" Style="{StaticResource RowLabel}"/>
                                    <Button x:Name="ChangeHotkeyButton" Grid.Column="1" Style="{StaticResource ShortcutButton}"
                                            VerticalAlignment="Center" Click="OnChangeHotkey"
                                            AutomationProperties.Name="Change the screen shortcut">
                                        <ItemsControl x:Name="HotkeyKeys" Style="{StaticResource Keycaps}"/>
                                    </Button>
                                </Grid>
                                <TextBlock x:Name="HotkeyMessage" Visibility="Collapsed" Style="{StaticResource RowMessage}"/>

                                <Border Style="{StaticResource RowLine}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Region shortcut" Style="{StaticResource RowLabel}"/>
                                    <Button x:Name="ChangeRegionHotkeyButton" Grid.Column="1" Style="{StaticResource ShortcutButton}"
                                            VerticalAlignment="Center" Click="OnChangeRegionHotkey"
                                            AutomationProperties.Name="Change the region shortcut">
                                        <ItemsControl x:Name="RegionHotkeyKeys" Style="{StaticResource Keycaps}"/>
                                    </Button>
                                </Grid>
                                <TextBlock x:Name="RegionHotkeyMessage" Visibility="Collapsed" Style="{StaticResource RowMessage}"/>
                            </StackPanel>
                        </Border>

                        <!-- Launch at startup -->
                        <Border Style="{StaticResource Card}" Margin="0">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Launch at startup" Style="{StaticResource RowLabel}"/>
                                    <CheckBox x:Name="StartupToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                              VerticalAlignment="Center" Margin="0,0,6,0"
                                              Checked="OnStartupToggled" Unchecked="OnStartupToggled"
                                              AutomationProperties.Name="Launch at startup"/>
                                </Grid>
                                <TextBlock x:Name="StartupMessage" Visibility="Collapsed" Style="{StaticResource RowMessage}"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
