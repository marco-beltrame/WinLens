<Window x:Class="WinLens.Views.RegionSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Cursor="Cross"
        UseLayoutRounding="True">
    <Canvas x:Name="Root" Background="Transparent">
        <Rectangle x:Name="DimTop"    Fill="#80000000"/>
        <Rectangle x:Name="DimBottom" Fill="#80000000"/>
        <Rectangle x:Name="DimLeft"   Fill="#80000000"/>
        <Rectangle x:Name="DimRight"  Fill="#80000000"/>
        <!-- Fixed colours, not the theme's: this is drawn over a dimmed screenshot of
             anything at all, where only light on dark is sure to read. -->
        <Rectangle x:Name="SelectionRect"
                   Stroke="#A9A0FF"
                   StrokeThickness="2"
                   Fill="Transparent"
                   Visibility="Collapsed"
                   IsHitTestVisible="False"/>
        <Border x:Name="SizeChip"
                Background="#E616171B"
                BorderBrush="#393B46"
                BorderThickness="1"
                CornerRadius="6"
                Padding="7,3"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <TextBlock x:Name="SizeText"
                       Foreground="#F2F2F5"
                       FontFamily="{StaticResource UiFont}"
                       FontSize="11.5"
                       FontWeight="SemiBold"/>
        </Border>
    </Canvas>
</Window>
