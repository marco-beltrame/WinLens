<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Light palette: same keys as Palette.Dark.xaml. -->

    <!-- Surfaces, from the back forward -->
    <SolidColorBrush x:Key="WindowBrush"         Color="#F4F4F7"/>
    <SolidColorBrush x:Key="CardBrush"           Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ControlBrush"        Color="#F1F1F5"/>
    <SolidColorBrush x:Key="ControlHoverBrush"   Color="#E8E8EE"/>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#DFDFE7"/>
    <SolidColorBrush x:Key="PopupBrush"          Color="#FFFFFF"/>

    <!-- Lines -->
    <SolidColorBrush x:Key="BorderBrush"         Color="#E7E7EC"/>
    <SolidColorBrush x:Key="BorderStrongBrush"   Color="#D6D7DF"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextBrush"           Color="#1B1B22"/>
    <SolidColorBrush x:Key="TextSubtleBrush"     Color="#5E606C"/>
    <SolidColorBrush x:Key="TextFaintBrush"      Color="#6F717E"/>

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush"         Color="#5B4CE0"/>
    <SolidColorBrush x:Key="AccentHoverBrush"    Color="#6A5CE8"/>
    <SolidColorBrush x:Key="AccentPressedBrush"  Color="#4E40CC"/>
    <SolidColorBrush x:Key="AccentTextBrush"     Color="#5546D6"/>
    <SolidColorBrush x:Key="AccentSoftBrush"     Color="#ECEAFD"/>
    <SolidColorBrush x:Key="OnAccentBrush"       Color="#FFFFFF"/>

    <!-- Status -->
    <SolidColorBrush x:Key="DangerBrush"         Color="#C93434"/>
    <SolidColorBrush x:Key="SuccessBrush"        Color="#1A7F45"/>

    <!-- Keycaps -->
    <SolidColorBrush x:Key="KeycapBrush"         Color="#FFFFFF"/>
    <SolidColorBrush x:Key="KeycapBorderBrush"   Color="#D6D7DF"/>

    <sys:Double x:Key="ShadowOpacity">0.18</sys:Double>

</ResourceDictionary>
